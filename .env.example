# Copy the appropriate variables into apps/web/.env.local and apps/api/.env.
# No production secret belongs in apps/web.

# WEB: public values are bundled into the browser.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
# NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-local-publishable-key
# NEXT_PUBLIC_POSTHOG_KEY=replace-with-project-key
# NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# NEXT_PUBLIC_SENTRY_DSN=https://replace-with-browser-dsn
# WEB: server-side public-catalog fetch target.
API_URL=http://localhost:4000

# API: place these in apps/api/.env.
NODE_ENV=development
PORT=4000
APP_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000
# SUPABASE_URL=http://127.0.0.1:54321
# SUPABASE_PUBLISHABLE_KEY=replace-with-local-publishable-key
# SUPABASE_SECRET_KEY=replace-with-local-service-role-key
# STRIPE_SECRET_KEY=sk_test_replace
# STRIPE_WEBHOOK_SECRET=whsec_replace
# RESEND_API_KEY=re_replace
# EMAIL_FROM=Pitch Lab <coaching@your-verified-domain.example>
# SENTRY_DSN=https://replace-with-server-dsn
# JOB_SECRET=replace-with-at-least-32-random-characters
